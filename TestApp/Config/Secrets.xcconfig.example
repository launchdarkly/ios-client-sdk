// Copy this file to Secrets.xcconfig in the same directory and fill in the values. Secrets.xcconfig is ignored by git.

LAUNCHDARKLY_MOBILE_KEY = mob-...

// Optional: a second environment's key. The client then starts both, and a picker chooses which one the buttons use.
// LAUNCHDARKLY_SECONDARY_MOBILE_KEY = mob-...

// production, or staging for LaunchDarkly's ld-stg endpoints.
LAUNCHDARKLY_ENVIRONMENT = production
